#!/bin/sh
# Fast, staged-file-scoped checks. Heavy/full-repo checks live in pre-push and CI.
set -e

export PATH="$HOME/.cargo/bin:$PATH"

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

RS_STAGED=$(printf '%s\n' "$STAGED" | grep -E '\.rs$' || true)
MD_STAGED=$(printf '%s\n' "$STAGED" | grep -E '\.md$' || true)

if [ -n "$RS_STAGED" ]; then
  echo "Running Cargo fmt check..."
  cargo fmt --check

  # clippy type-checks as part of its analysis, so a separate `cargo check` is redundant.
  echo "Running Cargo clippy..."
  cargo clippy --workspace --all-targets -- -D warnings
else
  echo "No staged *.rs files — skipping fmt/clippy."
fi

if [ -n "$MD_STAGED" ]; then
  echo "Running markdownlint on staged Markdown files..."
  # shellcheck disable=SC2086
  npx markdownlint-cli $MD_STAGED
else
  echo "No staged *.md files — skipping markdownlint."
fi

echo "Pre-commit checks passed."
