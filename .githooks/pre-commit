#!/bin/sh
# Mirrors the Rust compilation, clippy, depgraph, script linting, markdownlint, and test checks.
set -e

export PATH="$HOME/.cargo/bin:$PATH"

echo "Running Cargo check..."
cargo check --workspace

echo "Running Cargo fmt check..."
cargo fmt --check

echo "Running Cargo clippy..."
cargo clippy --workspace --all-targets -- -D warnings

echo "Running Cargo unit test suite..."
cargo test --workspace

echo "Running Rust agent-skills depgraph verification..."
cargo run -p agent-skills -- depgraph --verify

echo "Running Rust agent-skills lint-scripts compliance check..."
cargo run -p agent-skills -- lint-scripts

echo "Running markdownlint check..."
npx markdownlint-cli --ignore "graphify-out/**" "**/*.md"

echo "Running python backward-compatibility test suite..."
python3 -m unittest discover -s scripts/tests
